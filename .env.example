# Environment variables for MedGuard AI backend
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# Your Alibaba Cloud Model Studio (DashScope) API key.
# Get one from: https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=

# (Optional) Alibaba Cloud Model Studio Workspace ID.
# Only needed if you use the new workspace-specific domain.
# Find it on the Workspace Details page in the Model Studio console.
# DASHSCOPE_WORKSPACE_ID=

# (Optional) Override the DashScope API base URL.
# Defaults to the legacy international domain. Uncomment the one that matches your region.
# International (Singapore) -- default:
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# International with workspace ID (Singapore):
# DASHSCOPE_BASE_URL=https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# China (Beijing):
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# (Optional) Override the Qwen vision model name.
# Defaults to qwen3-vl-plus. Other options: qwen-vl-max, qwen3.8-max, qwen3.7-plus
# ALIBABA_VISION_MODEL=qwen3-vl-plus

# (Optional) Override the Qwen text model name for medicine search.
# Defaults to qwen-plus (cheaper/faster than vision models).
# Other options: qwen-turbo, qwen-max
# ALIBABA_TEXT_MODEL=qwen-plus

# Backend server port
PORT=3001
