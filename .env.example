# MedGuard AI Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit your real API key to version control.

# Server Port
PORT=5000

# Alibaba Cloud Model Studio (DashScope) API Key
# Sign up at Alibaba Cloud Model Studio: https://www.alibabacloud.com/help/en/model-studio
# If left blank or invalid, MedGuard AI will automatically run in fallback DEMO MODE.
DASHSCOPE_API_KEY=sk-ws-H.DDMXMXI.iJ3i.MEYCIQD1qv0WM24VpC14aKH6vv-4bV_wiUCJKM4wjfl35-sm7gIhAOR0Bw7oVb0O6dxYXJZEzIOnQbAwULVPtH3k7PEWQ8Oj

# Alibaba Cloud Model Studio OpenAI-compatible endpoint
# International endpoint: https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Mainland China endpoint: https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Models
QWEN_VISION_MODEL=qwen3-vl-plus
QWEN_TEXT_MODEL=qwen-plus
